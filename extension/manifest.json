{
  "manifest_version": 3,
  "name": "Netflix 字幕本地翻译",
  "version": "0.2.0",
  "description": "接收 Windows 桌面控制面板的设置，在 Netflix 内显示本地翻译。",
  "key": "",
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "settings.js",
        "player.js"
      ],
      "css": [
        "player.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
